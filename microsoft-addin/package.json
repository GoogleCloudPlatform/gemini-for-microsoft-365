{
  "name": "gemini-o365-addin",
  "version": "1.2.0",
  "description": "Gemini AI Assistant for Microsoft 365 (Word, PowerPoint, Excel, Outlook)",
  "author": "Sathya AG, Principal Architect, Google",
  "license": "Apache-2.0",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "python3 ../scripts/generate_manifest.py --dev && office-addin-debugging start manifest-dev.xml desktop",
    "start:dev": "python3 ../scripts/generate_manifest.py --dev && office-addin-debugging start manifest-dev.xml desktop",
    "start:excel": "python3 ../scripts/generate_manifest.py --dev && office-addin-debugging start manifest-dev.xml desktop --app excel",
    "start:word": "python3 ../scripts/generate_manifest.py --dev && office-addin-debugging start manifest-dev.xml desktop --app word",
    "start:powerpoint": "python3 ../scripts/generate_manifest.py --dev && office-addin-debugging start manifest-dev.xml desktop --app powerpoint",
    "start:outlook": "python3 ../scripts/generate_manifest.py --dev --host outlook && office-addin-debugging start manifest-dev.xml desktop --app outlook",
    "stop": "office-addin-debugging stop manifest-dev.xml",
    "stop:outlook": "office-addin-debugging stop manifest-dev.xml",
    "test": "node tests/common-adapters.test.mjs && node tests/excel.test.mjs && node tests/outlook.test.mjs && node tests/word.test.mjs && node tests/ppt.test.mjs",
    "test:common": "node tests/common-adapters.test.mjs",
    "test:excel": "node tests/excel.test.mjs",
    "test:outlook": "node tests/outlook.test.mjs",
    "validate": "python3 ../scripts/generate_manifest.py --dev && office-addin-manifest validate manifest-dev.xml",
    "validate:prod": "python3 ../scripts/generate_manifest.py && office-addin-manifest validate manifest-gemini.xml",
    "validate:outlook": "python3 ../scripts/generate_manifest.py --host outlook --dev && office-addin-manifest validate manifest-dev.xml",
    "watch": "webpack --mode development --watch",
    "test:word": "node tests/word.test.mjs",
    "test:ppt": "node tests/ppt.test.mjs"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "acorn": "^8.11.3",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^4.0.10",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}