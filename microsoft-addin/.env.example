# ==============================================================================
# Microsoft Add-In Environment Configuration
# ==============================================================================

# 1. Backend Gemini Proxy URL (Direct Vertex AI or StreamAssist Enterprise endpoint)
# Local development default: http://localhost:8080/askGeminiEnterprise
# Cloud Run deployment: https://auth-proxy-YOUR_PROJECT_HASH.us-central1.run.app/askGeminiEnterprise
GEMINI_PROXY_URL=http://localhost:8080/askGeminiEnterprise

# 2. Frontend Cloud Run / Hosting URL (where this add-in is hosted)
# Webpack injects this into dist/manifest.xml automatically during `npm run build`
# Example: https://gemini-frontend-YOUR_GCP_PROJECT.us-central1.run.app
FRONTEND_URL=https://gemini-frontend-YOUR_GCP_PROJECT.us-central1.run.app

# Local Dev Server Port
PORT=3000
