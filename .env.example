# ==============================================================================
# Central Environment Configuration Template
# Copy this file to .env and configure it with your specific environment values.
# DO NOT commit your .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Run Deployment Target & Service Account
# ------------------------------------------------------------------------------
# The Google Cloud Project ID where your Cloud Run services (frontend & proxies)
# will be deployed.
PROJECT_ID="your-gcp-project-id"

# The Google Cloud region where your Cloud Run services will run.
# Default: us-central1 (or your preferred region, e.g., europe-west1)
REGION="us-central1"

# The dedicated service account used by Cloud Run services for Server-to-Server
# communication and invoking backend APIs.
SERVICE_ACCOUNT="gemini-office365-sa@your-gcp-project-id.iam.gserviceaccount.com"

# ------------------------------------------------------------------------------
# 2. Gemini Enterprise / Discovery Engine Target
# ------------------------------------------------------------------------------
# The Google Cloud Project ID hosting your Gemini Enterprise / Discovery Engine instance.
# (Can be the same as PROJECT_ID or a centralized enterprise AI project).
GE_GCP_PROJECT_ID="your-gemini-enterprise-project-id"

# The location of your Discovery Engine datastore/engine ("us", "eu", or "global").
GE_GCP_LOCATION="us"

# The endpoint location for the Discovery Engine StreamAssist API.
STREAM_ASSIST_ENDPOINT_LOCATION="us"

# The ID of your Gemini Enterprise Search / Chat application or engine.
GEMINI_ENTERPRISE_APP_ID="your-gemini-enterprise-app-id"

# The collection ID within Discovery Engine (almost always "default_collection").
ENTERPRISE_COLLECTION_ID="default_collection"

# The assistant ID within Discovery Engine (almost always "default_assistant").
ENTERPRISE_ASSISTANT_ID="default_assistant"

# ------------------------------------------------------------------------------
# 3. Identity & Authentication (Microsoft Entra ID & Google OAuth)
# ------------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) Application (client) ID from your Azure App Registration.
MICROSOFT_ENTRA_APP_ID="your-microsoft-entra-app-id"

# Microsoft Entra ID Directory (tenant) ID.
MICROSOFT_ENTRA_TENANT_ID="your-microsoft-entra-tenant-id"

# Google OAuth 2.0 Web Client ID used for user authentication / Gemini Enterprise grounding.
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Enforce Microsoft Entra ID SSO token verification (default: true).
# Set to "false" only during initial sandbox / local testing before Entra SSO app registration.
REQUIRE_ENTRA_AUTH="true"

# Identity federation mode: "cloud_identity" (Google Workspace / Cloud Identity) or "wif" (Workforce Identity Federation).
# Default: "cloud_identity" (or "auto" to detect automatically).
USER_AUTH_MODE="cloud_identity"

# ------------------------------------------------------------------------------
# 4. Optional Pre-Configured Endpoints (Leave commented out to auto-derive)
# ------------------------------------------------------------------------------
# If you are using pre-authorized or custom domain URLs, uncomment and set them here.
# deploy.sh will use these exact URLs instead of querying Cloud Run.
#
# GEMINI_PROXY_URL="https://auth-proxy-YOUR_HASH.us-central1.run.app/askGeminiEnterprise"
# FRONTEND_URL="https://gemini-frontend-YOUR_HASH.us-central1.run.app"
